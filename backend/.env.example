# Database: Turso (libSQL). Leave both unset to use a local SQLite file (backend/nonce.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Signals detector (see backend/nonce/signals.py). With OPENAI_API_KEY below, OpenAI's Decisions API is used.
# Nothing set → every request that needs signals comes to you.
# SIGNALS_MODEL=gpt-6-luna
# Or your own HTTP service that answers {"kind", "state"} with signals (takes priority):
SIGNALS_URL=
SIGNALS_API_KEY=
# Or a Python class instead: SIGNALS_DETECTOR=mypackage.detector:MyDetector

# Required. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NONCE_ENCRYPTION_KEY=
# Required. Shared with web/.env.local; also signs approve/deny links. Generate with: openssl rand -hex 24
NONCE_ADMIN_TOKEN=

PUBLIC_URL=http://localhost:8000
# After moving PUBLIC_URL, list the old ones so connected AI apps keep working without reconnecting.
# OLD_PUBLIC_URLS=["https://nonce-old.example.com"]
DASHBOARD_URL=http://localhost:3000
# Hosts the MCP endpoint accepts. Add your tunnel or domain, e.g. ["localhost:*","nonce.example.com"]
# ALLOWED_HOSTS=["localhost:*","127.0.0.1:*"]

# Google sign-in, Gmail, Calendar and Drive. See README → "Set up Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack connection. See README → "Set up Slack".
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Recall agent for Cautious mode (OpenAI Agents SDK). Unset → word matching instead.
OPENAI_API_KEY=
# Or Azure OpenAI:
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# LUNA_MODEL=gpt-6-luna
# LUNA_FALLBACK_MODEL=gpt-5.6-luna
# LUNA_EFFORT=low
# LUNA_TIMEOUT_S=8

# Push notifications with approve/deny buttons via ntfy (https://ntfy.sh). Pick a long, unguessable topic.
NTFY_TOPIC=
# NTFY_URL=https://ntfy.sh

# Text messages (Twilio), off unless SMS_ENABLED=true. Verify confirms a user's number (console.twilio.com > Verify > Services).
# Approval texts also need a sending number or messaging service; US numbers need A2P 10DLC or
# toll-free verification. Without these, local dev prints codes and texts to the server log.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=
# Set in production so missing Twilio settings turn texting off instead of logging codes.
# PRODUCTION=true

# Web Push to installed phones. Generate with: uv run python -m nonce.webpush
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Policy (defaults shown)
# DEFAULT_TTL_S=600
# MAX_AUTO_TTL_S=3600
# HARD_MAX_TTL_S=86400
# MAX_SEARCHES_PER_MINUTE=10
# MAX_REQUESTS_PER_HOUR=12
# QUIET_HOURS=[0,6]
# TIMEZONE=America/Los_Angeles
