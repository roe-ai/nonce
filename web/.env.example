NONCE_API_URL=http://localhost:8000
# Same value as NONCE_ADMIN_TOKEN in backend/.env. Server-side only; never sent to the browser.
NONCE_ADMIN_TOKEN=
# URL agents use to reach the API, shown in MCP config snippets (defaults to NONCE_API_URL).
# NONCE_PUBLIC_API_URL=https://nonce.example.com
# Signs session cookies. Any long random string (openssl rand -hex 32); defaults to NONCE_ADMIN_TOKEN.
NONCE_SESSION_SECRET=
