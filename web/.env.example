PRIVATO_API_URL=http://localhost:8000
# Same value as PRIVATO_ADMIN_TOKEN in backend/.env. Server-side only; never sent to the browser.
PRIVATO_ADMIN_TOKEN=
# URL agents use to reach the API, shown in MCP config snippets (defaults to PRIVATO_API_URL).
# PRIVATO_PUBLIC_API_URL=https://privato.example.com
# Signs session cookies. Any long random string (openssl rand -hex 32); defaults to PRIVATO_ADMIN_TOKEN.
PRIVATO_SESSION_SECRET=
